# AI Jarvis (macOS) — copy to .env and adjust. run-macos.sh auto-loads .env.
# All values have sensible defaults except the oMLX API key.

# Local oMLX server (MLX model server, OpenAI-compatible API)
JARVIS_OMLX_BASE_URL=http://127.0.0.1:9999
# Set this to the API key configured in your oMLX GUI.
JARVIS_OMLX_API_KEY=

# Models served by oMLX
JARVIS_OMLX_VISION_MODEL=MiniCPM-o-4_5-4bit
JARVIS_OMLX_CHAT_MODEL=Qwen3.6-35B-A3B-MLX-4bit
JARVIS_OMLX_STT_MODEL=whisper-large-v3-turbo

# System-audio loopback device (create a Multi-Output Device in Audio MIDI Setup)
JARVIS_AUDIO_DEVICE="BlackHole 2ch"

# Perception / duplex timing (seconds)
JARVIS_PERCEPTION_INTERVAL=6
JARVIS_DUPLEX_AUDIO_SECONDS=6

# Start monitoring as soon as the backend boots
JARVIS_AUTO_START=1
